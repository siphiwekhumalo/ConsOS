{
  "name": "constructos",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @constructos/db migrate",
    "db:seed": "pnpm --filter @constructos/db seed",
    "dev:api": "pnpm --filter @constructos/api dev",
    "dev:web": "pnpm --filter @constructos/web dev"
  }
}
