# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# The state contains generated secrets: keep the bucket private, versioned and KMS-encrypted.
bucket         = "baheka-terraform-state-af-south-1"
key            = "constructos/production/terraform.tfstate"
region         = "af-south-1"
dynamodb_table = "baheka-terraform-locks"
encrypt        = true
